{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve Drafts",
            "type": "shell",
            "command": "hugo server -D",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "hugo",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Commit & Push",
            "type": "shell",
            "command": "git add . && git commit -m \"$(date '+%Y-%m-%d %H:%M:%S')\" && git push",
            "problemMatcher": []
        },
        {
            "label": "New Post",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/new-post.sh",
            "problemMatcher": []
        },
    ]
}
